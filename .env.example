APP_NAME="Photo Backup Organizer"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://photo-backup-organizer.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=photo_backup
DB_USERNAME=root
DB_PASSWORD=
# On Railway, set DB_CONNECTION=mysql and provide the full connection string
# in DB_URL instead of the DB_HOST/DB_PORT/DB_DATABASE/DB_USERNAME/DB_PASSWORD
# variables above (e.g. mysql://user:password@host:3306/railway).
# DB_URL=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail -------------------------------------------------------------------
# Local development: Mailpit (bundled with Laragon) captures every message at
# http://localhost:8025 — nothing leaves your machine. These are the local
# defaults. To send real email in production, pick one provider block below.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="support@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Gmail SMTP: create an App Password (Google Account -> Security -> App
# passwords; 2-Step Verification must be on). MAIL_USERNAME and
# MAIL_FROM_ADDRESS must be the same Gmail address. Port 587 uses STARTTLS
# (leave MAIL_SCHEME empty); port 465 needs MAIL_SCHEME=smtps.
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SCHEME=null
# MAIL_USERNAME="you@gmail.com"
# MAIL_PASSWORD="your-16-char-app-password"
# MAIL_FROM_ADDRESS="you@gmail.com"

# Transactional providers. Set MAIL_MAILER to the driver and fill in its key.
# MAIL_FROM_ADDRESS must be a sender/domain verified with the provider.
#   Resend     -> MAIL_MAILER=resend     + RESEND_API_KEY
#   Postmark   -> MAIL_MAILER=postmark   + POSTMARK_API_KEY
#   Mailgun    -> MAIL_MAILER=mailgun    + MAILGUN_DOMAIN, MAILGUN_SECRET
#   Amazon SES -> MAIL_MAILER=ses        + AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
RESEND_API_KEY=
POSTMARK_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net

# --- Cloud backup configuration -------------------------------------------
# Railpack-only: extra PHP extensions (e.g. gd,exif,mbstring,bcmath,zip,pdo_mysql)
# installed on top of the FrankenPHP image. NOT used when deploying with the
# provided Dockerfile, whose upload limits are baked in through uploads.ini.
# RAILPACK_PHP_EXTENSIONS=

# Disk that holds the uploaded photos, their thumbnails and the avatars.
# "public" keeps them on the local filesystem (storage/app/public) and is the
# default for local development. Set it to "s3" (or any other disk defined in
# config/filesystems.php) on Vercel: the container filesystem is ephemeral, so
# the files must live in a bucket. The bucket stays private - photos are always
# streamed through the application, never through a public URL.
PHOTOS_DISK=public

# Set PHOTOS_CLOUD_DISK=s3 to push "Back Up Now" uploads to an S3-compatible
# bucket (fill in the AWS_* values). When empty, the service mirrors photos to
# the local "private" disk so the backup flow works in local development.
# Note: when PHOTOS_CLOUD_DISK is the same bucket as PHOTOS_DISK, the backup
# is not an offsite copy.
PHOTOS_CLOUD_DISK=
PHOTOS_LOCAL_MIRROR_DISK=local
PHOTOS_TRASH_RETENTION_DAYS=30
PHOTOS_MAX_UPLOAD_MB=20
PHOTOS_SUPPORT_EMAIL=support@example.com

# --- Direct uploads (photo goes straight to the bucket) ----------------------
# Only used when PHOTOS_DISK points at an S3 bucket: the browser then asks the
# server for a short-lived signed URL and uploads the file itself, so the file
# never travels through the application server. Leave PHOTOS_DIRECT_UPLOAD off
# to keep the classic upload flow.
PHOTOS_DIRECT_UPLOAD=false
# How long the signed upload URL stays valid, in seconds.
PHOTOS_UPLOAD_URL_TTL=300
# How long the browser has to finish an upload, in minutes. Uploads that are
# never finished are cleaned up by "php artisan photos:prune-pending-uploads".
PHOTOS_PENDING_TTL_MINUTES=60

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Social sign-in (Google / Facebook) ------------------------------------
# Create OAuth credentials in the Google Cloud Console and Meta for Developers.
# The authorised redirect URL is {APP_URL}/auth/{provider}/callback. Leave a
# provider blank to hide its button on the sign-in screen.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"

VITE_APP_NAME="${APP_NAME}"

# --- Vercel deployment ------------------------------------------------------
# vercel.json builds the app with Dockerfile.vercel (FrankenPHP on PHP 8.4) and
# serves it through the Caddyfile. Add the variables below as Vercel project
# environment variables (Production and Preview); never commit real values here.
#
#   APP_KEY            output of: php artisan key:generate --show
#   APP_ENV            production
#   APP_DEBUG          false
#   APP_URL            https://your-domain (no trailing slash)
#   LOG_CHANNEL        stderr
#   SESSION_DRIVER     database
#   CACHE_STORE        database
#   QUEUE_CONNECTION   sync
#   DB_CONNECTION      mysql
#   DB_URL             mysql://user:password@host:port/database
#   PHOTOS_DISK        s3
#   AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_DEFAULT_REGION, AWS_BUCKET
#   PHOTOS_CLOUD_DISK   s3 (or another bucket if the backup must be offsite)
#   PHOTOS_DIRECT_UPLOAD  true (lets the browser upload straight to the bucket)
#   MAIL_MAILER        resend / postmark / ses + the matching key below
#   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
#   FACEBOOK_CLIENT_ID, FACEBOOK_CLIENT_SECRET
#
# The S3 bucket must stay private (no public ACL and no public bucket policy);
# the app serves every file through an authenticated controller.
#
# With PHOTOS_DIRECT_UPLOAD=true the bucket needs a CORS rule that allows the
# browser to PUT objects: allowed origins "https://your-domain" (plus
# "http://localhost:5173" while developing), methods PUT and HEAD, allowed
# headers "content-type" and "x-amz-*", expose "ETag". An S3 lifecycle rule
# that deletes everything under "incoming/" after one day cleans up uploads
# that were never finished.

